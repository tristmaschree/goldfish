{
  "manifest_version": 3,
  "name": "Goldfish",
  "version": "0.1.1",
  "description": "Forget tabs on purpose. Unload tabs you're done with right now, and let idle ones unload themselves, to free up memory.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Goldfish",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "contextMenus",
    "idle",
    "webNavigation",
    "favicon"
  ],
  "commands": {
    "unload-selected": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "Unload the current tab (or all selected tabs)"
    },
    "unload-others": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Unload all other tabs in this window"
    }
  }
}
